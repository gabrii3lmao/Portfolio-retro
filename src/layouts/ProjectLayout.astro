---
import { Icon } from "astro-icon/components";
import Anchor from "../components/common/Anchor.astro";
import Section from "../components/common/Section.astro";
import Seo from "../components/common/Seo.astro";
import Prose from "../components/Prose.astro";
import { defaultLocale, type Locale } from "../lib/i18n";
import type { ProjectFrontmatter } from "../lib/types";
import { getConfigurationCollection } from "../lib/utils";
import { tagIcons } from "../lib/tagIcons";
import Layout from "./Layout.astro";

type Props = { frontmatter: ProjectFrontmatter; locale?: Locale };

const { frontmatter, locale = defaultLocale } = Astro.props;
const { data: config } = await getConfigurationCollection(locale);
---

<Layout locale={locale}>
  <Fragment slot="head">
    <Seo
      locale={locale}
      baseUrl={config.site.baseUrl}
      path={`/projects/${frontmatter.slug}`}
      meta={{
        title: `${frontmatter.title} • ${config.personal.name}`,
        description: frontmatter.description,
        longDescription: frontmatter.longDescription,
        cardImage: frontmatter.cardImage,
        keywords: frontmatter.tags,
      }}
    />
  </Fragment>
  <Section class="mt-8">
    <div class="flex flex-col gap-4 mt-8 mb-16">
      <h1 class="text-3xl sm:text-4xl leading-tight font-display">
        {frontmatter.title}
      </h1>
      <div class="flex flex-wrap text-sm gap-2">
        {
          frontmatter.tags
            ? frontmatter.tags.map((tag) => (
                <span class="-zag-text -zag-bg zag-transition font-semibold py-1 px-2 flex items-center gap-1">
                  {tagIcons[tag.toLowerCase()] && (
                    <Icon name={tagIcons[tag.toLowerCase()]} class="w-3.5 h-3.5" />
                  )}
                  {tag}
                </span>
              ))
            : null
        }
      </div>
      <div class="flex flex-wrap gap-2">
        {
          frontmatter.githubUrl ? (
            <Anchor url={frontmatter.githubUrl} class="text-base" external>
              GitHub
            </Anchor>
          ) : null
        }
        {
          frontmatter.liveDemoUrl ? (
            <Anchor url={frontmatter.liveDemoUrl} class="text-base" external>
              Demo
            </Anchor>
          ) : null
        }
      </div>
    </div>
    <Prose>
      <slot />
    </Prose>
  </Section>
</Layout>
