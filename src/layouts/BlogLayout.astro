---
import Prose from "../components/Prose.astro";
import Section from "../components/common/Section.astro";
import Seo from "../components/common/Seo.astro";
import { defaultLocale, type Locale } from "../lib/i18n";
import type { ArticleFrontmatter } from "../lib/types";
import { getConfigurationCollection, processArticleDate } from "../lib/utils";
import Layout from "./Layout.astro";

type Props = { frontmatter: ArticleFrontmatter; locale?: Locale };

const { frontmatter, locale = defaultLocale } = Astro.props;
const articleDate = processArticleDate(frontmatter.timestamp, locale);
const { data: config } = await getConfigurationCollection(locale);
---

<Layout locale={locale}>
  <Fragment slot="head">
    <Seo
      locale={locale}
      baseUrl={config.site.baseUrl}
      path={`/blog/${frontmatter.slug}`}
      meta={{
        title: `${frontmatter.title} • ${config.personal.name}`,
        description: frontmatter.description,
        longDescription: frontmatter.longDescription,
        cardImage: frontmatter.cardImage,
        keywords: frontmatter.tags,
      }}
    />
  </Fragment>
  <Section class="pt-8">
    <div class="flex flex-col gap-4 mt-8 mb-16">
      <h1
        class="text-3xl sm:text-4xl leading-normal sm:leading-normal font-display"
      >
        {frontmatter.title}
      </h1>
      <div class="flex flex-col sm:flex-row justify-between gap-1">
        <span>{articleDate}</span>
        <span>{frontmatter.readTime} min</span>
      </div>
    </div>
    <Prose class="!font-serif">
      <slot />
    </Prose>
    <p class="pt-8">~{config.personal.name}</p>
  </Section>
</Layout>
