---
import {
  defaultLocale,
  htmlLang,
  localizePath,
  stripLocalePrefix,
  t,
  type Locale,
} from "../lib/i18n";
import { getConfigurationCollection } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  /** The locale of the current page. */
  locale?: Locale;
};

const { locale = defaultLocale } = Astro.props;
const { data: config } = await getConfigurationCollection(locale);

const otherLocale: Locale = locale === "pt" ? "en" : "pt";
const basePath = stripLocalePrefix(Astro.url.pathname, locale);
const switchHref = localizePath(basePath, otherLocale);
---
<header class="zag-bg zag-border-b zag-transition sticky top-0 w-full z-10">
  <div
    class="zag-bg zag-transition sm:hidden relative z-50 py-4 flex items-center"
  >
    <button class="zag-underline-expand px-4 min-h-11 min-w-11 flex items-center justify-center" type="button" aria-label="Toggle navigation menu">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 512 512"
        class="zag-fill zag-transition"
      >
        <title>{t(locale, "menuLabel")}</title>
        <path d="M80 96h352v32H80zm0 144h352v32H80zm0 144h352v32H80z"></path>
      </svg>
    </button>
  </div>
  <div id="navOverlay" class="hidden sm:hidden fixed inset-0 bg-neutral-900/50 z-40"></div>
  <nav
    id="navMenu"
    class="zag-bg zag-border-b zag-transition fixed sm:relative inset-x-0 top-0 h-auto flex justify-between flex-col gap-8 py-6 sm:py-4 text-xl sm:flex-row max-w-2xl mx-auto sm:pt-4 sm:border-none z-50"
  >
    <div
      class="flex flex-col font-mono font-medium gap-4 sm:flex-row px-4 sm:px-0 mt-16 sm:mt-0"
    >
      {
        Object.entries(config.menu).map((i) => (
          <Anchor url={i[1]} expandUnderline class="py-2 sm:py-0 min-h-11 sm:min-h-0 flex items-center">{i[0]}</Anchor>
        ))
      }
    </div>
    <div class="flex gap-4 justify-between px-4 sm:px-10">
      <a
        href={locale === 'pt' ? "/Gabriel_Moura_Luz_Curriculo.pdf" : "Gabriel_Moura_Luz___CV.pdf"}
        aria-label={t(locale, "resumeAria")}
        target="_blank"
        class="zag-underline-expand font-medium flex items-center gap-1 min-h-11 text-base sm:text-lg focus:outline-2 focus:outline-offset-2 focus:outline-zag-dark dark:focus:outline-zag-light"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="w-5 h-5 shrink-0 zag-fill zag-transition"
        >
          <path
            d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
          ></path>
        </svg>
        {t(locale, "resume")}
      </a>
      {
        config.personal.linkedinProfile && (
          <Anchor
            url={config.personal.linkedinProfile}
            aria-label={t(locale, "linkedinAria", { name: config.personal.name })}
            expandUnderline
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
            >
              <title>LinkedIn</title>
              <path
                class="zag-fill zag-transition"
                d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11.12 19h-3.08v-9h3.08v9zm-1.54-10.29c-.99 0-1.79-.8-1.79-1.79s.8-1.79 1.79-1.79 1.79.8 1.79 1.79-.8 1.79-1.79 1.79zm13.16 10.29h-3.08v-4.89c0-1.16-.02-2.64-1.61-2.64s-1.86 1.26-1.86 2.57v4.96h-3.08v-9h2.96v1.23h.04c.41-.78 1.4-1.6 2.88-1.6 3.08 0 3.65 2.03 3.65 4.66v4.71z"
              />
            </svg>
          </Anchor>
        )
      }
      {
        config.personal.githubProfile && (
          <Anchor
            url={config.personal.githubProfile}
            aria-label={t(locale, "githubAria", { name: config.personal.name })}
            expandUnderline
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              class="zag-fill zag-transition"
            >
              <title>GitHub</title>
              <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2" />
            </svg>
          </Anchor>
        )
      }
      <a
        href={switchHref}
        hreflang={htmlLang[otherLocale]}
        lang={htmlLang[otherLocale]}
        aria-label={t(locale, "switchLanguage")}
        class="zag-underline-expand font-medium flex items-center justify-center min-h-11 min-w-11 text-base sm:text-lg focus:outline-2 focus:outline-offset-2 focus:outline-zag-dark dark:focus:outline-zag-light"
      >
        {t(locale, "switchLanguageShort")}
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector("button") as HTMLButtonElement;
  const nav = document.getElementById("navMenu") as HTMLElement;
  const overlay = document.getElementById("navOverlay") as HTMLElement;
  let isOpen = false;

  function updateNavState() {
    const isMobile = window.matchMedia("(max-width: 640px)").matches;
    if (isMobile) {
      nav.style.transform = isOpen ? "translateY(0)" : "translateY(-100%)";
      overlay.classList.toggle("hidden", !isOpen);
    } else {
      nav.style.transform = "translateY(0)";
      overlay.classList.add("hidden");
      isOpen = false;
    }
  }

  function toggleNav() {
    isOpen = !isOpen;
    updateNavState();
  }

  function closeNav() {
    if (isOpen) {
      isOpen = false;
      updateNavState();
    }
  }

  button?.addEventListener("click", toggleNav);
  overlay?.addEventListener("click", closeNav);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeNav();
  });
  window.addEventListener("resize", updateNavState);

  updateNavState();
</script>
