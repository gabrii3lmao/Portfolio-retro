---
import { defaultLocale, type Locale } from "../lib/i18n";
import { processArticleDate } from "../lib/utils";
import Anchor from "./common/Anchor.astro";

export type Props = {
	title: string;
	description: string;
	url: string;
	duration?: string;
	timestamp?: Date;
	/** The locale of the current page. */
	locale?: Locale;
};

const {
	title,
	description,
	url,
	duration,
	timestamp,
	locale = defaultLocale,
} = Astro.props;
---

<div class="relative zag-text zag-transition flex flex-col gap-3 mb-8 hover-zag-dotted-grid">
  <Anchor url={url} class="text-xl">
    {title}
  </Anchor>
  <p class="">
    {description}
  </p>
  <div
    class="zag-muted zag-transition flex justify-between items-center"
  >
    {timestamp ? <p>{processArticleDate(timestamp, locale)}</p> : null}
    {duration ? <p>{duration}</p> : null}
  </div>
</div>
