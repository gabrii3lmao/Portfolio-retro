---
import { render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getConfigurationCollection, getLocalizedEntries } from "../../lib/utils";

export async function getStaticPaths() {
	const posts = await getLocalizedEntries("blog", "pt");
	const { data: config } = await getConfigurationCollection("pt");
	return posts.map((article) => ({
		params: { id: article.data.slug },
		props: {
			article: {
				...article,
				data: {
					...article.data,
					url: `${config.site.baseUrl}/blog/${article.data.slug}`,
				},
			},
		},
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BlogLayout frontmatter={article.data} locale="pt">
  <Content />
</BlogLayout>
