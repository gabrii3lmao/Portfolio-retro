---
import Section from "../components/common/Section.astro";
import Seo from "../components/common/Seo.astro";
import Layout from "../layouts/Layout.astro";
import { resolveHref, type Locale, t } from "../lib/i18n";
import { getConfigurationCollection } from "../lib/utils";

// The 404 page is shared by both locales, so the language is taken from the
// requested URL (`/en/whatever` → English). It falls back to Portuguese.
const locale: Locale = Astro.url.pathname.startsWith("/en") ? "en" : "pt";
const { data: config } = await getConfigurationCollection(locale);
---

<Layout locale={locale}>
  <Fragment slot="head">
    <Seo
      locale={locale}
      baseUrl={config.site.baseUrl}
      path="/"
      meta={config.notFoundMeta}
    />
  </Fragment>
  <Section class="mt-16">
    <h1 class="text-3xl sm:text-4xl font-display pb-8">
      {t(locale, "notFoundTitle")}
    </h1>
    <h2 class="text-xl sm:text-2xl pb-8">{t(locale, "notFoundHeading")}</h2>
    <p>
      {t(locale, "notFoundBeforeLink")}
      <a class="underline underline-offset-4 font-medium" href={resolveHref("/", locale)}
        >{t(locale, "notFoundLink")}</a
      >.
    </p>
  </Section>
</Layout>
